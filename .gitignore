# --- Data (generated) ---
# Everything under data/ is generated by the pipeline and published by CI.
# Only small hand-made test files in data/samples/ are committed.
data/*
!data/samples/
!data/samples/**
# Source files downloaded by hand (cannot be fetched from the cloud environment)
!data/manual/
!data/manual/**
# Soil moisture climatology (ERA5-Land), committed so the one-off download can resume across runs
!data/climatology/
!data/climatology/**

# Download cache (BDL, GDOS, OSM, Open-Meteo archive)
.cache/
pipeline/.cache/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# --- Node / Expo (app/) ---
node_modules/
app/.expo/
app/dist/
app/web-build/
app/android/
app/ios/
*.apk
*.aab
*.ipa
npm-debug.log*
yarn-error.log*

# --- Secrets ---
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
credentials.json

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
